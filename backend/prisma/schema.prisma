generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  PIX
  OTHER

  @@map("payment_method_type")
}

enum Recurrence {
  MONTHLY
  YEARLY

  @@map("recurrence")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  paymentMethods  PaymentMethod[]
  categories      Category[]
  expenses        Expense[]
  fixedBills      FixedBill[]
  sharedExpenses  SharedExpense[] @relation("SharedWith")
  createdShares   SharedExpense[] @relation("CreatedBy")

  @@map("users")
}

model PaymentMethod {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  name      String
  type      PaymentMethodType
  icon      String            @default("💳")
  isDefault Boolean           @default(false) @map("is_default")
  createdAt DateTime          @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("payment_methods")
}

model Category {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  emoji       String   @default("📁")
  budgetLimit Decimal? @map("budget_limit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  fixedBills FixedBill[]

  @@map("categories")
}

model Expense {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  amount          Decimal  @db.Decimal(12, 2)
  description     String?
  date            DateTime @default(now())
  categoryId      String?  @map("category_id")
  paymentMethodId String?  @map("payment_method_id")
  receiptUrl      String?  @map("receipt_url")
  isShared        Boolean  @default(false) @map("is_shared")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  sharedWith    SharedExpense[]

  @@map("expenses")
}

model SharedExpense {
  id           String   @id @default(uuid())
  expenseId    String   @map("expense_id")
  sharedWithId String   @map("shared_with_id")
  createdById  String   @map("created_by_id")
  splitAmount  Decimal  @db.Decimal(12, 2) @map("split_amount")
  isPaid       Boolean  @default(false) @map("is_paid")
  createdAt    DateTime @default(now()) @map("created_at")

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  sharedWith User    @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([expenseId, sharedWithId])
  @@map("shared_expenses")
}

model FixedBill {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  name       String
  amount     Decimal    @db.Decimal(12, 2)
  categoryId String?    @map("category_id")
  dueDay     Int        @map("due_day")
  recurrence Recurrence
  isPaid     Boolean    @default(false) @map("is_paid")
  lastPaidAt DateTime?  @map("last_paid_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("fixed_bills")
}
